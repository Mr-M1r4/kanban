# Copia este archivo a .env y ajusta los valores
# Conexion local (docker compose up -d db)
DATABASE_URL="postgresql://kanban:kanban@localhost:5432/kanban?schema=public"

# URL publica de la app (para los links de invitacion). Sin https en local.
APP_URL="http://localhost:3000"

# Opcional: PIN de 4-8 digitos para pedirlo al entrar con el correo.
# Si lo dejas vacio, basta con escribir el correo para entrar.
BOARD_PIN=""

# Opcional: clave de Resend para enviar el link de invitacion por correo.
# RESEND_API_KEY=""
# EMAIL_FROM="Kanban <invitaciones@tu-dominio.com>"
