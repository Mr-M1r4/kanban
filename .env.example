# Qué backend usar: "local" (datos en el navegador, sin cuenta) o "supabase" (equipo real).
NEXT_PUBLIC_BACKEND=local

# Carpeta donde se publica. En GitHub Pages el proyecto vive en /kanban.
# Para dominio propio o localhost déjalo vacío.
NEXT_PUBLIC_BASE_PATH=/kanban

# Solo para NEXT_PUBLIC_BACKEND=supabase.
# Project Settings > API: URL y clave "anon" (la pública). Se pueden exponer:
# la seguridad la pone el RLS de supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
